{
  "name": "@adobe/aem-block-collection",
  "private": true,
  "version": "1.0.0",
  "description": "Block collection for AEM",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint 'blocks/**/*.css' 'styles/*.css'",
    "lint": "npm run lint:js && npm run lint:css",
    "copy:es": "cp -r node_modules/@ms-onecloud/onecloud-web-components/dist/onecloud/web-components/es/* web-components/es/",
    "copy:components": "cp -r node_modules/@ms-onecloud/onecloud-web-components/dist/onecloud/web-components/es/components/* web-components/es/",
    "copy:umd": "cp -r node_modules/@ms-onecloud/onecloud-web-components/dist/onecloud/web-components/umd/onecloud-web-components.umd.js web-components/onecloud-web-components.umd.js",
    "copy:styles": "cp -r node_modules/@ms-onecloud/moray-reimagine-wc-theming/dist/css/*.css web-components/styles"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-block-collection.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-block-collection/issues"
  },
  "homepage": "https://github.com/adobe/aem-block-collection#readme",
  "devDependencies": {
    "@babel/core": "7.23.7",
    "@babel/eslint-parser": "7.23.3",
    "chai": "5.0.0",
    "eslint": "8.56.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.29.1",
    "stylelint": "16.1.0",
    "stylelint-config-standard": "36.0.0"
  },
  "dependencies": {
    "@adobe/aem-block-collection": "file:",
    "@ms-onecloud/moray-reimagine-wc-theming": "^11.0.2",
    "@ms-onecloud/onecloud-web-components": "^1.12.0"
  }
}
